# Puerto del servidor Express (por defecto 4000 en dev, Render asigna automáticamente en producción)
PORT=4000

# Cadena de conexión a MongoDB (local o MongoDB Atlas)
# Ejemplo local: mongodb://127.0.0.1:27017/hermanos-jota-dev
# Ejemplo producción: mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/hermanos-jota?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hermanos-jota-dev

# URL del frontend permitida por CORS
# En desarrollo: http://localhost:5173
# En producción: https://hermanos-jota-store.netlify.app
CLIENT_URL=https://hermanos-jota-store.netlify.app
